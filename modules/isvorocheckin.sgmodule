#!name=ISVORO Checkin
#!desc=ISVORO 自动签到
#!author=upperwizard
#!arguments=签到小时:0, 签到分钟:3, Token捕获:false
#!arguments-desc=参数说明:\n\n - 签到小时: 0-23点\n\n - 签到分钟: 0-59分\n\n - Token捕获: false=关闭, true=开启

[Script]
ISVOROToken = type=http-request, pattern=^https:\/\/isvoro\.com\/, script-path=isvoro.js, argument="ENABLE_CAPTURE={{{Token捕获}}}", timeout=10
ISVOROCheckin = type=cron, cronexp="{{{签到分钟}}} {{{签到小时}}} * * *", script-path=https://raw.githubusercontent.com/upperwizard/shadowrocket/main/scripts/isvoro.js, timeout=30
isvoro = type=http-request,engine=jsc,script-path=isvoro.js,pattern=^https:\/\/isvoro\.com\/checkin$,max-size=131072,timeout=10,script-update-interval=0,argument=ENABLE_CAPTURE={{{Token捕获}}},enable=true

[MITM]
hostname = %APPEND% isvoro.com
